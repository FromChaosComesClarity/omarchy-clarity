#!/usr/bin/env python3
"""Print the suite's library and actions as one JSON object, for the launcher overlay.

Clarity's own library, and EmuLatte's ROMs when that app is installed too: the two are one
suite, they keep their databases in the same data root when both AppImages sit together,
and one keystroke searching both is the point of them being a suite at all. Every row says
which app owns it and which binary plays it, so the overlay never has to guess.

⚠️ Nothing here is guessed. The app writes ~/.config/clarity/desktop.json on every
start — which binary it is, where its two databases are, and which command-palette actions
this build has — and this reads that. A plugin that derived its own paths would be a second
consumer computing its own answer, which is exactly how the library got orphaned once
before (the two-library.db split), and hardcoded paths only ever work on one machine.

If the descriptor is missing the answer is `ok: false`, never a guessed path: it means
Clarity is not installed, or has not been run since the version that writes it.

Usage: clarity-index [descriptor.json]
"""

import json
import os
import re
import sqlite3
import subprocess
import sys


def descriptor_path():
    if len(sys.argv) > 1 and sys.argv[1]:
        return sys.argv[1]
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(config, "clarity", "desktop.json")


def fail(message):
    print(json.dumps({"ok": False, "error": message, "games": [], "actions": []}))
    sys.exit(0)          # a shell plugin's backend reports trouble in-band; it never crashes


# ⚠️ Cover paths are stored RELATIVE to the app's data directory ("GameManagerConfig/images/
# Quake - Cover.jpg"), and the descriptor is the only thing that knows where that is. An
# absolute path is left alone — some rows carry one — and anything that is not actually a
# file on disk comes back empty rather than as a broken image.
def resolve_art(value, base_dir):
    raw = str(value or "").strip()
    if not raw:
        return ""
    path = raw if os.path.isabs(raw) else os.path.join(base_dir or "", raw)
    return path if os.path.isfile(path) else ""


# A launcher shows a sentence, not a press release: descriptions here run to 4,000 characters
# and average 250. Cut at a sentence end when there is one nearby, so the panel does not end
# mid-word — and cut in the index rather than in QML, because this JSON is parsed on every
# summon and the other 3,700 characters would be carried for nothing.
def blurb(value, limit=260):
    text = " ".join(str(value or "").split())
    if len(text) <= limit:
        return text
    cut = text[:limit]
    stop = max(cut.rfind(". "), cut.rfind("! "), cut.rfind("? "))
    if stop > limit * 0.55:
        return cut[:stop + 1]
    return cut[:cut.rfind(" ") if " " in cut else limit].rstrip(",;:-") + "\u2026"


def first_genre(value):
    # GENRE is a comma-joined list and the first one is the one the app treats as primary.
    return str(value or "").split(",")[0].strip()


def year_of(value):
    # RELEASED is free text across stores ("2016", "Jun 13, 2016", ""), so take the first
    # plausible year rather than trying to parse a date that has no agreed format.
    for token in re.findall(r"\b(19\d{2}|20\d{2})\b", str(value or "")):
        return token
    return ""


def read_games(db_path, base_dir):
    # ⚠️ Read-only, and immutable=0 so a live writer is never blocked and WAL content is
    # still visible. A checkpoint in progress yields a busy error rather than a wrong
    # answer — hence the timeout, and the caller keeping its previous index on failure.
    uri = "file:" + db_path.replace("?", "%3f").replace("#", "%23") + "?mode=ro&immutable=0"
    con = sqlite3.connect(uri, uri=True, timeout=2.0)
    try:
        con.execute("PRAGMA busy_timeout = 2000")
        rows = con.execute(
            """
            SELECT id, Game, Store, LaunchCommand, Installed, LastPlayed,
                   CoverArt, Description, GENRE, RELEASED, Playtime
              FROM games
             WHERE Game IS NOT NULL AND TRIM(Game) <> '' AND Game <> 'null'
               AND COALESCE(Hidden, 0) <> 1
             ORDER BY Game COLLATE NOCASE ASC
            """
        ).fetchall()
    finally:
        con.close()

    games = []
    for (gid, title, store, launch, installed, last_played,
         cover, description, genre, released, playtime) in rows:
        # The same rule as the app's isGameInstalled(): a launch command, and either no
        # install flag at all (rows that predate the column) or one that says installed.
        playable = bool(launch and str(launch).strip()) and (installed is None or installed == 1)
        games.append({
            "id": int(gid),
            "name": str(title),
            "store": str(store or ""),
            "installed": playable,
            "lastPlayed": int(last_played or 0),
            "cover": resolve_art(cover, base_dir),
            "blurb": blurb(description),
            "genre": first_genre(genre),
            "year": year_of(released),
            "playtime": int(playtime or 0),
        })
    return games


# ── The sibling library ───────────────────────────────────────────────────────────────
# ⚠️ This RUNS EmuLatte's own index script rather than reading its database here. How to
# read that library is EmuLatte's knowledge, not ours: the systems join, the rule for what
# counts as playable, and the re-homing of cover paths that go stale whenever its data
# directory moves. A second copy of all that living here would drift the first time its
# schema changed, which is the same mistake as a hardcoded path wearing a different hat.
#
# The script is found by plugin id under the Omarchy plugins directory. That is a location
# the shell defines, not a guess about where anyone keeps their games.
COMPANION_ID = "io.github.fromchaoscomesclarity.emulatte"


def companion_script():
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    path = os.path.join(config, "omarchy", "plugins", COMPANION_ID, "scripts", "emulatte-index")
    return path if os.access(path, os.X_OK) or os.path.isfile(path) else ""


# ⚠️ A companion that is missing, slow, or broken is not an error. Clarity's own library is
# the answer this script exists to give, and it is returned unchanged in every one of those
# cases rather than the whole launcher going dark because a second app is having a bad day.
def companion_games():
    script = companion_script()
    if not script:
        return []
    try:
        done = subprocess.run([sys.executable, script], capture_output=True, text=True, timeout=10)
        data = json.loads(done.stdout or "{}")
    except Exception:                                         # noqa: BLE001
        return []
    if not data.get("ok") or not data.get("exec"):
        return []

    games = []
    for g in data.get("games") or []:
        games.append({
            "id": g.get("id"),
            "name": g.get("name") or "",
            # The system short name stands in for the store: it is what tells a ROM apart
            # from a shop copy at a glance, and from the other ROM of the same name. There
            # are 13 titles in my own library that exist in both.
            "store": g.get("short") or g.get("system") or "",
            "installed": bool(g.get("installed")),
            "lastPlayed": int(g.get("lastPlayed") or 0),
            "cover": g.get("cover") or "",
            "blurb": g.get("blurb") or "",
            "genre": g.get("genre") or "",
            "year": g.get("year") or "",
            "playtime": 0,                 # EmuLatte does not keep minutes played
            "source": "emulatte",
            "exec": data.get("exec") or "",
        })
    return games


def main():
    path = descriptor_path()
    try:
        with open(path, "r", encoding="utf-8") as fh:
            desc = json.load(fh)
    except FileNotFoundError:
        fail("Clarity has not been run on this machine yet")
    except Exception as exc:                                  # noqa: BLE001 — any unreadable descriptor is the same story
        fail("cannot read %s: %s" % (path, exc))

    library = desc.get("libraryDb")
    if not library or not os.path.isfile(library):
        fail("the library database named by the descriptor is not there")

    try:
        games = read_games(library, desc.get("baseDir") or "")
    except Exception as exc:                                  # noqa: BLE001
        fail("cannot read the library: %s" % exc)

    # Every row carries its owner and the binary that plays it, so the overlay routes Enter
    # by row instead of assuming one app owns the whole list.
    own_exec = desc.get("exec") or ""
    for g in games:
        g["source"] = "clarity"
        g["exec"] = own_exec
    games.extend(companion_games())

    actions = [
        {"id": str(a.get("id")), "name": str(a.get("name"))}
        for a in (desc.get("actions") or [])
        if isinstance(a, dict) and a.get("id") and a.get("name")
    ]

    print(json.dumps({
        "ok": True,
        "exec": desc.get("exec") or "",
        "version": desc.get("version") or "",
        "games": games,
        "actions": actions,
    }))


if __name__ == "__main__":
    main()
